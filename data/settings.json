  "testimonials": {
    "enabled": true,
    "eyebrow": "KẾT QUẢ THỰC TẾ",
    "title": "KẾT QUẢ THỰC TẾ",
    "items": [
      { "stars": 5, "quote": "Chương trình boxing fundamentals thay đổi hoàn toàn cách tôi tiếp cận việc tập luyện. Kỹ thuật rõ ràng, huấn luyện viên tận tâm.", "name": "Nguyễn Minh Khoa", "label": "Boxing Fundamentals", "avatarUrl": "https://randomuser.me/api/portraits/men/47.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1555597673-b21d5c935865?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Sau 3 tháng học Advanced Combinations, tôi đã thi đấu và đạt giải. Nội dung khóa học rất thực chiến và bài bản.", "name": "Trần Quốc Bảo", "label": "Advanced Combinations", "avatarUrl": "https://randomuser.me/api/portraits/men/52.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1584464491033-06628f3a6b7b?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Fighter Conditioning giúp tôi tăng sức bền đáng kể. Bài tập được thiết kế khoa học, phù hợp cả người mới lẫn vận động viên.", "name": "Lê Thanh Hương", "label": "Fighter Conditioning", "avatarUrl": "https://randomuser.me/api/portraits/women/28.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Học Muay Thai Basics ở đây là quyết định đúng đắn nhất. HLV tận tình, bài học bài bản, tiến bộ rõ rệt sau mỗi tuần.", "name": "Phạm Đức Anh", "label": "Muay Thai Basics", "avatarUrl": "https://randomuser.me/api/portraits/men/61.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1549719386-74dfcbf7dbed?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Chưa bao giờ tôi nghĩ mình có thể học được kỹ thuật đấm quyền nhanh đến thế. Khóa Speed & Power thật sự ấn tượng!", "name": "Vũ Thị Mai", "label": "Speed & Power", "avatarUrl": "https://randomuser.me/api/portraits/women/39.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1552196563-55cd4e45efb3?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Tôi đã thử nhiều nơi nhưng Dapper Combat khác hẳn — chất lượng giảng dạy cao, cộng đồng nhiệt tình và nội dung luôn được cập nhật.", "name": "Hoàng Văn Tùng", "label": "All Access Member", "avatarUrl": "https://randomuser.me/api/portraits/men/23.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1517438476312-10d79c077509?w=400&h=300&fit=crop&q=80" },
      { "stars": 4, "quote": "Khóa Footwork Pro thực sự cải thiện di chuyển của tôi. Sau 2 tháng, cách tôi đứng và di chuyển trong ring đã hoàn toàn khác.", "name": "Đinh Thị Lan", "label": "Footwork Pro", "avatarUrl": "https://randomuser.me/api/portraits/women/55.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Nội dung khóa học rất chi tiết, video chất lượng cao. Tôi có thể xem lại nhiều lần mà không lo hết hạn. Đáng đồng tiền!", "name": "Bùi Quốc Hưng", "label": "Boxing Fundamentals", "avatarUrl": "https://randomuser.me/api/portraits/men/34.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1555597673-b21d5c935865?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Đây là lần đầu tiên tôi học boxing online mà cảm thấy như học trực tiếp. Phản hồi của HLV rất nhanh và cụ thể.", "name": "Ngô Thị Thu", "label": "Elite Coaching", "avatarUrl": "https://randomuser.me/api/portraits/women/14.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1584464491033-06628f3a6b7b?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Sau 6 tháng với gói Elite Coaching, tôi đã giảm 8kg và thành tích thi đấu cải thiện rõ rệt. Cảm ơn Dapper Combat!", "name": "Trương Minh Đức", "label": "Elite Coaching", "avatarUrl": "https://randomuser.me/api/portraits/men/65.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=400&h=300&fit=crop&q=80" },
      { "stars": 4, "quote": "Hướng dẫn dinh dưỡng kèm theo rất hữu ích. Trước đây tôi chỉ tập mà không biết ăn đúng cách, giờ hiệu quả hơn hẳn.", "name": "Lý Thị Phương", "label": "Pro All Access", "avatarUrl": "https://randomuser.me/api/portraits/women/67.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1549719386-74dfcbf7dbed?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Kỹ năng phòng thủ của tôi kém lắm trước đây. Khóa Defense Mastery đã giúp tôi hiểu và thực hành defense đúng cách.", "name": "Cao Đình Nam", "label": "Defense Mastery", "avatarUrl": "https://randomuser.me/api/portraits/men/78.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1517438476312-10d79c077509?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Cộng đồng học viên ở Dapper Combat rất thân thiện. Được cùng nhau luyện tập, chia sẻ kinh nghiệm — tuyệt vời!", "name": "Đỗ Thị Hoa", "label": "Pro All Access", "avatarUrl": "https://randomuser.me/api/portraits/women/81.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1552196563-55cd4e45efb3?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Video chất lượng 4K, góc quay đa chiều giúp tôi quan sát kỹ thuật rõ ràng hơn nhiều so với xem video thông thường.", "name": "Phan Văn Khải", "label": "Advanced Combinations", "avatarUrl": "https://randomuser.me/api/portraits/men/43.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=400&h=300&fit=crop&q=80" },
      { "stars": 5, "quote": "Giao viên giải đáp thắc mắc cực kỳ tận tình. Tôi nhắn tin lúc 11 giờ đêm mà sáng hôm sau đã có phản hồi chi tiết.", "name": "Nguyễn Thị Bích", "label": "Elite Coaching", "avatarUrl": "https://randomuser.me/api/portraits/women/49.jpg", "feedbackImageUrl": "https://images.unsplash.com/photo-1555597673-b21d5c935865?w=400&h=300&fit=crop&q=80" }
    ]
