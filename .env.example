PORT=3000
# Khóa ký phiên đăng nhập quản trị: chuỗi ngẫu nhiên ≥ 32 ký tự. Để trống = server tự tạo và lưu ở data/.jwt-secret
JWT_SECRET=
NODE_ENV=production
# Tài khoản quản trị đầu tiên khi chạy thật (mật khẩu ≥ 10 ký tự). Không đặt → máy chủ tạo mật khẩu tạm, in 1 lần ra log
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Nơi lưu dữ liệu và ảnh tải lên (để trống = data/ và public/assets/uploads/ trong thư mục code)
DC_DATA_DIR=
DC_UPLOAD_DIR=
# Chạy sau proxy (Nginx cùng máy: để trống). Sau Cloudflare + Nginx: số lớp proxy, vd 2
TRUST_PROXY=

# Địa chỉ website (để thông báo kèm link mở trang quản trị)
SITE_URL=

# Báo đơn mới qua Telegram: tạo bot với @BotFather → lấy token; nhắn bot 1 tin rồi lấy chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Báo đơn mới qua email (SMTP). Gmail: smtp.gmail.com, cổng 465, SMTP_SECURE=true, mật khẩu ứng dụng
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_EMAIL=

# Tiếng Anh tự dịch bằng AI (Claude): khóa lấy ở console.anthropic.com → API Keys.
# Có thể để trống và nhập khóa trong /admin → Tiếng Anh (AI)
ANTHROPIC_API_KEY=
